    )


# ================================================================
# 22. TRAINING LOSS
# ================================================================


def calculate_loss(
    s1_logits,
    s2_logits,
    s1_target,
    s2_target
):


    # Shift because the model predicts next token.

    s1_logits = s1_logits[
        :, :-1, :
    ]

    s2_logits = s2_logits[
        :, :-1, :
    ]


    s1_target = s1_target[
        :, 1:
    ]

    s2_target = s2_target[
        :, 1:
    ]


    loss_s1 = F.cross_entropy(
        s1_logits.reshape(
            -1,
            s1_logits.size(-1)
        ),
        s1_target.reshape(-1)
    )


    loss_s2 = F.cross_entropy(
        s2_logits.reshape(
            -1,
            s2_logits.size(-1)
        ),
        s2_target.reshape(-1)
    )


    loss = (
        loss_s1
        +
        loss_s2
    )


    return loss


# ================================================================
# 23. TRAIN ONE EPOCH
# ================================================================


def train_one_epoch(
    windows
):

    model.train()


    total_loss = 0.0

    used = 0


    # Shuffle windows

    indices = np.random.permutation(
        len(windows)
    )


    for idx in indices:

        window = windows[idx]


        try:

            s1_ids, s2_ids, stamp = tokenize_window(
                window
            )

            # Hard device synchronization immediately before forward().
            s1_ids = s1_ids.to(DEVICE)
            s2_ids = s2_ids.to(DEVICE)
            stamp = stamp.to(DEVICE)

            optimizer.zero_grad(
                set_to_none=True
            )


            try:
                s1_logits, s2_logits = model(
                    s1_ids,
                    s2_ids,
                    stamp=stamp,
                    use_teacher_forcing=True,
                    s1_targets=s1_ids,
                )
            except RuntimeError as e:
                if "same device" in str(e).lower() or "cuda" in str(e).lower() and "cpu" in str(e).lower():
                    print("\nDEVICE DEBUG:")
                    print("DEVICE:", DEVICE)
                    print("s1_ids:", s1_ids.device)
                    print("s2_ids:", s2_ids.device)
                    print("stamp:", stamp.device)
                    print("model parameter devices:", sorted({str(p.device) for p in model.parameters()}))
                raise


            loss = calculate_loss(
                s1_logits,
                s2_logits,
                s1_ids,
                s2_ids
            )


            if not torch.isfinite(loss):

                continue


            loss.backward()


            torch.nn.utils.clip_grad_norm_(
                trainable_params,
                GRAD_CLIP
            )


            optimizer.step()


            total_loss += float(
                loss.detach().cpu()
            )

            used += 1


        except RuntimeError as e:

            if "out of memory" in str(e).lower():

                print(
                    "WARNING: GPU memory issue."
                )

                if DEVICE == "cuda":

                    torch.cuda.empty_cache()


                continue


            raise


    if used == 0:

        return float("inf")


    return total_loss / used


# ================================================================
# 24. VALIDATION
# ================================================================


def validation_loss(
    windows
):

    model.eval()


    total_loss = 0.0

    used = 0


    with torch.no_grad():

        for window in windows:

            try:

                s1_ids, s2_ids, stamp = tokenize_window(
                    window
                )

                s1_ids = s1_ids.to(DEVICE)
                s2_ids = s2_ids.to(DEVICE)
                stamp = stamp.to(DEVICE)

                s1_logits, s2_logits = model(
                    s1_ids,
                    s2_ids,
                    stamp=stamp,
                    use_teacher_forcing=True,
                    s1_targets=s1_ids,
                )


                loss = calculate_loss(
                    s1_logits,
                    s2_logits,
                    s1_ids,
                    s2_ids
                )


                if torch.isfinite(loss):

                    total_loss += float(
                        loss.cpu()
                    )

                    used += 1


            except RuntimeError:

                if DEVICE == "cuda":

                    torch.cuda.empty_cache()


    if used == 0:

        return float("inf")


    return total_loss / used


# ================================================================
# 25. TRAIN LoRA
# ================================================================


print()
print("=" * 80)
print("STARTING LoRA TRAINING")
print("=" * 80)


history = []

best_val_loss = float("inf")

best_state = None

patience_counter = 0


for epoch in range(
    1,
    MAX_EPOCHS + 1
):


    train_loss = train_one_epoch(
        train_windows
    )


    val_loss = validation_loss(
        val_windows
    )


    history.append(
        {
            "epoch": epoch,
            "train_loss": train_loss,
            "validation_loss": val_loss
        }
    )


    print()

    print(
        f"Epoch {epoch:02d}/{MAX_EPOCHS}"
    )

    print(
        f"Train Loss      : {train_loss:.6f}"
    )

    print(
        f"Validation Loss : {val_loss:.6f}"
    )


    # ------------------------------------------------------------
    # Save best model
    # ------------------------------------------------------------

    if val_loss < best_val_loss:

        best_val_loss = val_loss

        patience_counter = 0

        best_state = {
            name: parameter.detach().cpu().clone()
            for name, parameter
            in model.named_parameters()
            if parameter.requires_grad
        }


        print(
            "BEST MODEL UPDATED"
        )


        torch.save(
            {
                "epoch": epoch,
                "validation_loss": val_loss,
                "lora_state_dict": best_state,
                "lora_rank": LORA_RANK,
                "lora_alpha": LORA_ALPHA,
                "context_length": CONTEXT_LENGTH
            },
            os.path.join(
                OUTPUT_DIR,
                "best_lora_weights.pt"
            )
        )


    else:

        patience_counter += 1


    # ------------------------------------------------------------
    # Automatic early stopping
    # ------------------------------------------------------------

    if (
        epoch >= MIN_EPOCHS
        and
        patience_counter >= PATIENCE
    ):

        print()

        print(
            "Early stopping triggered."
        )

        print(
            "Validation loss stopped improving."
        )

        break


# ================================================================
# 26. SAVE TRAINING HISTORY
# ================================================================


history_df = pd.DataFrame(
    history
)


history_file = os.path.join(
    OUTPUT_DIR,
    "training_history.csv"
)


history_df.to_csv(
    history_file,
    index=False
)


print()
print(
    "Training history saved:"
)

print(
    history_file
)


# ================================================================
# 27. RESTORE BEST LoRA WEIGHTS
# ================================================================


if best_state is not None:

    for name, parameter in model.named_parameters():

        if (
            parameter.requires_grad
            and
            name in best_state
        ):

            parameter.data.copy_(
                best_state[name].to(
                    DEVICE
                )
            )


# ================================================================
# 28. SAVE FINAL LoRA WEIGHTS
# ================================================================


final_state = {
    name: parameter.detach().cpu()
    for name, parameter
    in model.named_parameters()
    if parameter.requires_grad
}


final_weights_file = os.path.join(
    OUTPUT_DIR,
    "final_lora_weights.pt"
)


torch.save(
    {
        "lora_state_dict": final_state,
        "lora_rank": LORA_RANK,
        "lora_alpha": LORA_ALPHA,
        "context_length": CONTEXT_LENGTH
    },
    final_weights_file
)


print()
print(
    "Final LoRA weights saved:"
)

print(
    final_weights_file
)


# ================================================================
# 29. KRONOS PREDICTION
# ================================================================


print()
print("=" * 80)
print("GENERATING KRONOS PREDICTION")
print("=" * 80)


# ---------------------------------------------------------------
# IMPORTANT:
#
# Use the 400 days immediately before test period
# as Kronos context.
# ---------------------------------------------------------------


context_df = development_df.tail(
    CONTEXT_LENGTH
).copy()


actual_df = test_df.copy()


# ---------------------------------------------------------------
# Create Kronos predictor
# ---------------------------------------------------------------


predictor = KronosPredictor(
    model=model,
    tokenizer=tokenizer,
    device=DEVICE,
    max_context=512
)


# ---------------------------------------------------------------
# Prepare columns
# ---------------------------------------------------------------


prediction_input = context_df[
    [
        "open",
        "high",
        "low",
        "close",
        "volume"
    ]
].copy()


x_timestamp = context_df[
    "timestamp"
].copy()


y_timestamp = actual_df[
    "timestamp"
].copy()


# ---------------------------------------------------------------
# Predict
# ---------------------------------------------------------------


try:

    pred_df = predictor.predict(
        df=prediction_input,
        x_timestamp=x_timestamp,
        y_timestamp=y_timestamp,
        pred_len=len(actual_df),
        T=1.0,
        top_p=0.9,
        sample_count=1,
        verbose=True
    )


except Exception as e:

    print()
    print(
        "Kronos prediction failed:"
    )

    print(e)

    raise


# ================================================================
# 30. CLEAN PREDICTIONS
# ================================================================


pred_df = pred_df.reset_index()

pred_df = pred_df.rename(
    columns={
        "index": "timestamp"
    }
)


if "timestamp" not in pred_df.columns:

    pred_df["timestamp"] = (
        y_timestamp.values
    )


pred_df["timestamp"] = pd.to_datetime(
    pred_df["timestamp"]
)


# ================================================================
# 31. ACTUAL + PREDICTION
# ================================================================


result = actual_df[
    [
        "timestamp",
        "open",
        "high",
        "low",
        "close",
        "volume"
    ]
].copy()


result = result.rename(
    columns={
        "open": "actual_open",
        "high": "actual_high",
        "low": "actual_low",
        "close": "actual_close",
        "volume": "actual_volume"
    }
)


result = result.merge(
    pred_df[
        [
            "timestamp",
            "open",
            "high",
            "low",
            "close"
        ]
    ],
    on="timestamp",
    how="left"
)


result = result.rename(
    columns={
        "open": "kronos_open",
        "high": "kronos_high",
        "low": "kronos_low",
        "close": "kronos_close"
    }
)


# ================================================================
# 32. BASELINE
# ================================================================


# Naive baseline:
#
# Tomorrow's predicted close =
# today's actual close.
#
# This is a standard simple benchmark.

last_training_close = float(
    context_df["close"].iloc[-1]
)


baseline_values = []

previous_close = last_training_close


for _ in range(
    len(result)
):

    baseline_values.append(
        previous_close
    )


    # For the next baseline point,
    # use the actual previous close.

    if len(baseline_values) <= len(result):

        current_index = (
            len(baseline_values) - 1
        )

        if current_index < len(result):

            previous_close = float(
                result.iloc[
                    current_index
                ]["actual_close"]
            )


result["baseline_close"] = (
    baseline_values
)


# ================================================================
# 33. DIVERGENCE
# ================================================================


result["kronos_divergence"] = (
    result["kronos_close"]
    -
    result["actual_close"]
)


result["baseline_divergence"] = (
    result["baseline_close"]
    -
    result["actual_close"]
)


result["kronos_error_pct"] = (
    result["kronos_divergence"]
    /
    result["actual_close"]
    *
    100
)


# ================================================================
# 34. METRICS
# ================================================================


actual = result[
    "actual_close"
].astype(float).values


prediction = result[
    "kronos_close"
].astype(float).values


baseline = result[
    "baseline_close"
].astype(float).values


valid = (
    np.isfinite(actual)
    &
    np.isfinite(prediction)
)


actual_valid = actual[valid]

prediction_valid = prediction[valid]

baseline_valid = baseline[valid]


mae = np.mean(
    np.abs(
        prediction_valid
        -
        actual_valid
    )
)


rmse = np.sqrt(
    np.mean(
        (
            prediction_valid
            -
            actual_valid
        ) ** 2
    )
)


mape = np.mean(
    np.abs(
        (
            prediction_valid
            -
            actual_valid
        )
        /
        actual_valid
    )
) * 100


baseline_mae = np.mean(
    np.abs(
        baseline_valid
        -
        actual_valid
    )
)


baseline_rmse = np.sqrt(
    np.mean(
        (
            baseline_valid
            -
            actual_valid
        ) ** 2
    )
)


print()
print("=" * 80)
print("FINAL RESULTS")
print("=" * 80)


print(
    f"Kronos MAE       : {mae:.4f}"
)

print(
    f"Kronos RMSE      : {rmse:.4f}"
)

print(
    f"Kronos MAPE      : {mape:.4f}%"
)

print()

print(
    f"Baseline MAE     : {baseline_mae:.4f}"
)

print(
    f"Baseline RMSE    : {baseline_rmse:.4f}"
)


# ================================================================
# 35. SAVE PREDICTIONS
# ================================================================


prediction_file = os.path.join(
    OUTPUT_DIR,
    "predictions.csv"
)


result.to_csv(
    prediction_file,
    index=False
)


print()
print(
    "Prediction file:"
)

print(
    prediction_file
)


# ================================================================

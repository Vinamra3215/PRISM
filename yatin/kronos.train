# ================================================================
# 7. DATA CLEANING FUNCTIONS
# ================================================================


def find_column(df, possible_names):

    """
    Find a column despite differences in:
        spaces
        capitalization
        underscores
        naming
    """

    normalized = {}

    for col in df.columns:

        name = (
            str(col)
            .strip()
            .lower()
            .replace("_", " ")
        )

        normalized[name] = col

    for wanted in possible_names:

        wanted_clean = (
            wanted
            .strip()
            .lower()
            .replace("_", " ")
        )

        if wanted_clean in normalized:

            return normalized[wanted_clean]

    return None


def standardize_ohlcv(df, source_name):
    """
    Convert different HCLTECH column formats into:
    timestamp, open, high, low, close, volume.
    All timestamps are converted to timezone-naive IST.
    """
    print()
    print("Processing:", source_name)
    print("Original columns:")
    print(df.columns.tolist())

    timestamp_col = find_column(
        df,
        ["timestamp", "timestamps", "datetime", "date", "Date", "time"]
    )
    if timestamp_col is None:
        raise ValueError(f"No timestamp/date column found in {source_name}")

    open_col = find_column(df, ["open", "open price"])
    high_col = find_column(df, ["high", "high price"])
    low_col = find_column(df, ["low", "low price"])
    close_col = find_column(df, ["close", "close price", "last price"])

    if open_col is None:
        raise ValueError(f"Open column missing in {source_name}")
    if high_col is None:
        raise ValueError(f"High column missing in {source_name}")
    if low_col is None:
        raise ValueError(f"Low column missing in {source_name}")
    if close_col is None:
        raise ValueError(f"Close column missing in {source_name}")

    volume_col = find_column(
        df,
        [
            "volume",
            "total traded quantity",
            "total trade quantity",
            "total traded qty",
            "total trade qty",
        ],
    )

    result = pd.DataFrame()

    # Normalize timestamps to timezone-naive IST.
    parsed = pd.to_datetime(
        df[timestamp_col].astype(str).str.strip(),
        errors="coerce",
    )

    # Mixed timezone strings can produce an object Series, so normalize
    # each value safely.
    normalized_timestamps = []
    for value in parsed:
        if pd.isna(value):
            normalized_timestamps.append(pd.NaT)
            continue
        try:
            ts = pd.Timestamp(value)
            if ts.tzinfo is not None:
                ts = ts.tz_convert("Asia/Kolkata").tz_localize(None)
            normalized_timestamps.append(ts)
        except Exception:
            normalized_timestamps.append(pd.NaT)

    result["timestamp"] = pd.to_datetime(
        normalized_timestamps,
        errors="coerce",
    )

    result["open"] = pd.to_numeric(df[open_col], errors="coerce")
    result["high"] = pd.to_numeric(df[high_col], errors="coerce")
    result["low"] = pd.to_numeric(df[low_col], errors="coerce")
    result["close"] = pd.to_numeric(df[close_col], errors="coerce")

    if volume_col is not None:
        volume = (
            df[volume_col]
            .astype(str)
            .str.replace(",", "", regex=False)
            .str.replace(" ", "", regex=False)
        )
        result["volume"] = pd.to_numeric(volume, errors="coerce")
    else:
        result["volume"] = 0.0

    result = result.replace([np.inf, -np.inf], np.nan)
    result = result.dropna(
        subset=["timestamp", "open", "high", "low", "close"]
    )

    result = result[
        (result["open"] > 0)
        & (result["high"] > 0)
        & (result["low"] > 0)
        & (result["close"] > 0)
    ]

    result = result.sort_values("timestamp")
    result = result.reset_index(drop=True)

    print("Rows after cleaning:", len(result))
    if len(result):
        print("Start:", result["timestamp"].min())
        print("End:", result["timestamp"].max())

    return result


# ================================================================
# 8. LOAD HCLTECH FILES
# ================================================================


def load_all_hcltech():
    print()
    print("=" * 80)
    print("SEARCHING FOR HCLTECH DATA")
    print("=" * 80)

    frames = []

    for file_path in DATA_FILES:
        if not os.path.exists(file_path):
            print()
            print("NOT FOUND:")
            print(file_path)
            continue

        print()
        print("FOUND:")
        print(file_path)

        try:
            df = pd.read_parquet(file_path)
            print("Rows:", len(df))

            cleaned = standardize_ohlcv(df, file_path)
            cleaned["source"] = file_path
            frames.append(cleaned)

        except Exception as e:
            print()
            print("Could not use file:")
            print(file_path)
            print("Reason:")
            print(e)

    if not frames:
        raise FileNotFoundError("No usable HCLTECH Parquet file found.")

    print()
    print("Number of usable files:", len(frames))

    combined = pd.concat(frames, ignore_index=True)
    combined["timestamp"] = pd.to_datetime(
        combined["timestamp"], errors="coerce"
    )
    combined = combined.dropna(subset=["timestamp"])
    combined = combined.sort_values("timestamp")

    # If the same minute exists in multiple source files, retain one copy.
    combined = combined.drop_duplicates(
        subset=["timestamp", "open", "high", "low", "close", "volume"]
    )
    combined = combined.reset_index(drop=True)

    return combined


# ================================================================
# 9. CONVERT MINUTE DATA TO DAILY DATA
# ================================================================


def convert_to_daily(df):

    print()
    print("=" * 80)
    print("CONVERTING HCLTECH DATA TO DAILY OHLCV")
    print("=" * 80)


    df = df.copy()


    # Remove timezone safely

    try:

        if df["timestamp"].dt.tz is not None:

            df["timestamp"] = (
                df["timestamp"]
                .dt.tz_convert("Asia/Kolkata")
                .dt.tz_localize(None)
            )

    except Exception:

        pass


    df["date"] = (
        df["timestamp"]
        .dt.normalize()
    )


    daily = (
        df
        .groupby("date")
        .agg(
            open=("open", "first"),
            high=("high", "max"),
            low=("low", "min"),
            close=("close", "last"),
            volume=("volume", "sum")
        )
        .reset_index()
    )


    daily = daily.rename(
        columns={
            "date": "timestamp"
        }
    )


    daily = daily.sort_values(
        "timestamp"
    )


    daily = daily.drop_duplicates(
        subset=["timestamp"],
        keep="last"
    )


    daily = daily.reset_index(
        drop=True
    )


    print(
        "Daily rows:",
        len(daily)
    )

    print(
        "Daily start:",
        daily["timestamp"].min()
    )

    print(
        "Daily end:",
        daily["timestamp"].max()
    )


    return daily



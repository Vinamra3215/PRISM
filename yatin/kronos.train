        mode="lines",
        name="Actual",
        line=dict(
            width=2
        )
    ),
    row=2,
    col=1
)


fig.add_trace(
    go.Scatter(
        x=result["timestamp"],
        y=result["kronos_close"],
        mode="lines",
        name="Kronos + LoRA",
        line=dict(
            width=2,
            dash="dash"
        )
    ),
    row=2,
    col=1
)


# ================================================================
# 41. DIVERGENCE
# ================================================================


fig.add_trace(
    go.Scatter(
        x=result["timestamp"],
        y=result["kronos_divergence"],
        mode="lines",
        name="Kronos Divergence",
        line=dict(
            width=2
        )
    ),
    row=3,
    col=1
)


fig.add_hline(
    y=0,
    row=3,
    col=1,
    line_dash="dot"
)


# ================================================================
# 42. TRAINING LOSS
# ================================================================


if len(history_df) > 0:

    fig.add_trace(
        go.Scatter(
            x=history_df["epoch"],
            y=history_df["train_loss"],
            mode="lines+markers",
            name="Training Loss"
        ),
        row=4,
        col=1
    )


    fig.add_trace(
        go.Scatter(
            x=history_df["epoch"],
            y=history_df["validation_loss"],
            mode="lines+markers",
            name="Validation Loss"
        ),
        row=4,
        col=1
    )



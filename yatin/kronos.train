# ================================================================
# 19. CONVERT OHLCV TO KRONOS INPUT
# ================================================================


def make_kronos_input(df):
    """
    Prepare the six numerical features used by the official KronosPredictor:
    open, high, low, close, volume, amount.

    Each window is normalized using its own mean/std, matching KronosPredictor.
    """
    x = df[["open", "high", "low", "close", "volume"]].copy()

    for col in x.columns:
        x[col] = pd.to_numeric(x[col], errors="coerce")

    x = x.replace([np.inf, -np.inf], np.nan)
    x = x.ffill().bfill()

    x["volume"] = x["volume"].fillna(0.0)

    # Kronos uses an optional amount feature. For HCLTECH data we
    # reconstruct it when the source file does not contain it.
    x["amount"] = x["volume"] * x[
        ["open", "high", "low", "close"]
    ].mean(axis=1)

    values = x[
        ["open", "high", "low", "close", "volume", "amount"]
    ].values.astype(np.float32)

    mean = values.mean(axis=0)
    std = values.std(axis=0)

    values = (values - mean) / (std + 1e-5)
    values = np.clip(values, -5.0, 5.0)

    return x, values


# ================================================================
# 20. TOKENIZE ONE WINDOW
# ================================================================


@torch.no_grad()
def tokenize_window(df):
    _, values = make_kronos_input(df)

    tensor = torch.tensor(
        values,
        dtype=torch.float32,
        device=DEVICE,
    ).unsqueeze(0)

    token_output = tokenizer.encode(
        tensor,
        half=True,
    )

    if not isinstance(token_output, (tuple, list)) or len(token_output) != 2:
        raise RuntimeError(
            "Kronos tokenizer must return (s1_ids, s2_ids) with half=True."
        )

    # IMPORTANT: some Kronos tokenizer versions return token IDs on CPU
    # even when the input tensor is on CUDA. Always move the returned
    # tensors explicitly to the exact same device as the model.
    s1_ids = token_output[0].long().to(DEVICE)
    s2_ids = token_output[1].long().to(DEVICE)

    timestamps = pd.to_datetime(
        df["timestamp"],
        errors="coerce",
    )

    stamp_df = pd.DataFrame(
        {
            "minute": timestamps.dt.minute,
            "hour": timestamps.dt.hour,
            "weekday": timestamps.dt.weekday,
            "day": timestamps.dt.day,
            "month": timestamps.dt.month,
        }
    )

    stamp = torch.tensor(
        stamp_df.values.astype(np.float32),
        dtype=torch.float32,
        device=DEVICE,
    ).unsqueeze(0)

    # Final hard guarantee: every model input is on the same device.
    s1_ids = s1_ids.to(device=DEVICE, non_blocking=False)
    s2_ids = s2_ids.to(device=DEVICE, non_blocking=False)
    stamp = stamp.to(device=DEVICE, non_blocking=False)

    return s1_ids, s2_ids, stamp


# ================================================================
# 21. CREATE TRAINING WINDOWS
# ================================================================


def create_windows(df, stride=1):
    """
    Create overlapping 400-day context windows.
    A window is one self-supervised training example.
    """
    windows = []

    if len(df) < CONTEXT_LENGTH:
        return windows

    for start_idx in range(
        0,
        len(df) - CONTEXT_LENGTH + 1,
        stride,
    ):
        end_idx = start_idx + CONTEXT_LENGTH
        windows.append(
            df.iloc[start_idx:end_idx].copy()
        )

    return windows



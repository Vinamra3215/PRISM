import os
import glob
import warnings
import numpy as np
import pandas as pd
from scipy.stats import spearmanr
from statsmodels.tsa.stattools import adfuller

warnings.filterwarnings("ignore")

DATA_DIR = "/home/soq/1min based data of nifty50"
OUT_DIR = "/home/soq/__shutupandbendover/tanishq/prism_phase1_results"
os.makedirs(OUT_DIR, exist_ok=True)

# -------------------------------------------------------------------------
# 1. Load Data & Resample to Daily OHLCV
# -------------------------------------------------------------------------
print("Loading and aggregating parquet files to daily OHLCV bars...")
parquet_files = [
    f for f in glob.glob(os.path.join(DATA_DIR, "*.parquet"))
    if not any(k in f.lower() for k in ["summary", "metric", "checkpoint"])
]

all_stocks = []
for file_path in sorted(parquet_files):
    ticker = os.path.basename(file_path).split("-")[0].split(".")[0]
    try:
        df = pd.read_parquet(file_path)
    except Exception:
        continue

    col_dict = {str(c).lower().strip(): c for c in df.columns}
    required = ["open", "high", "low", "close", "volume"]
    if not all(k in col_dict for k in required):
        continue

    time_col = None
    for candidate in ["timestamp", "date", "datetime", "time"]:
        if candidate in col_dict:
            time_col = col_dict[candidate]
            break

    if time_col is None:
        continue

    std_df = pd.DataFrame({
        "dt": pd.to_datetime(df[time_col]).dt.tz_localize(None),
        "open": pd.to_numeric(df[col_dict["open"]], errors="coerce"),
        "high": pd.to_numeric(df[col_dict["high"]], errors="coerce"),
        "low": pd.to_numeric(df[col_dict["low"]], errors="coerce"),
        "close": pd.to_numeric(df[col_dict["close"]], errors="coerce"),
        "volume": pd.to_numeric(df[col_dict["volume"]], errors="coerce")
    }).dropna()

    std_df["trade_date"] = std_df["dt"].dt.date

    daily = std_df.groupby("trade_date").agg({
        "open": "first",
        "high": "max",
        "low": "min",
        "close": "last",
        "volume": "sum"
    }).dropna()

    daily.index = pd.to_datetime(daily.index)
    daily = daily[daily["volume"] > 0].copy()

    if len(daily) < 150:
        continue

    daily["ticker"] = ticker
    all_stocks.append(daily)

panel_df = pd.concat(all_stocks).reset_index().rename(columns={"trade_date": "date"})
tickers = panel_df["ticker"].unique()
print(f"Loaded {len(tickers)} valid stocks into panel dataset.")

# -------------------------------------------------------------------------
# Step P1: Compute All 12 Category 1 Features (Price & Return)
# -------------------------------------------------------------------------
print("\nComputing 12 Category 1 Price & Return Features...")

def compute_cat1_features(df):
    df = df.sort_values("date").reset_index(drop=True)

    # 1. Log Return (1-day)
    df["feat_log_ret_1d"] = np.log(df["close"] / df["close"].shift(1))

    # 2. Return 5-day
    df["feat_ret_5d"] = df["close"].pct_change(5)

    # 3. Return 10-day
    df["feat_ret_10d"] = df["close"].pct_change(10)

    # 4. Return 20-day
    df["feat_ret_20d"] = df["close"].pct_change(20)

    # 5. Return 60-day
    df["feat_ret_60d"] = df["close"].pct_change(60)

    # 6. Return 120-day
    df["feat_ret_120d"] = df["close"].pct_change(120)

    # 7. Intraday Range
    df["feat_intraday_range"] = (df["high"] - df["low"]) / df["close"]

    # 8. Open-Close Spread
    df["feat_open_close_spread"] = (df["close"] - df["open"]) / df["open"]

    # 9. Gap (Overnight Return)
    df["feat_gap_return"] = (df["open"] - df["close"].shift(1)) / df["close"].shift(1)

    # 10. Close-to-High Distance
    df["feat_close_to_high_dist"] = (df["high"] - df["close"]) / df["high"]

    # 11. 52-Week High Distance
    roll_max_252 = df["high"].rolling(252, min_periods=40).max()
    df["feat_52w_high_dist"] = (roll_max_252 - df["close"]) / roll_max_252

    # 12. 52-Week Low Distance
    roll_min_252 = df["low"].rolling(252, min_periods=40).min()
    df["feat_52w_low_dist"] = (df["close"] - roll_min_252) / roll_min_252

    # Forward Target Return: Actual next-day return
    df["target_fwd_ret"] = df["close"].pct_change().shift(-1)

    return df

processed_list = []
for ticker, group in panel_df.groupby("ticker"):
    processed_list.append(compute_cat1_features(group))

full_features_df = pd.concat(processed_list).reset_index(drop=True)
feature_cols = [c for c in full_features_df.columns if c.startswith("feat_")]

# -------------------------------------------------------------------------
# Calibration Window: Jan 2022 to Dec 2023 ONLY
# -------------------------------------------------------------------------
sample_mask = (full_features_df["date"] >= pd.Timestamp("2022-01-01")) & (full_features_df["date"] <= pd.Timestamp("2023-12-31"))
sample_df = full_features_df[sample_mask].copy()

# -------------------------------------------------------------------------
# Stationarity Test (Percent returns and distance ratios are bounded)
# -------------------------------------------------------------------------
print("Verifying time-series stationarity...")
stationarity = {}
for col in feature_cols:
    # Bounded ratios and returns are mathematically stationary differences
    # We check ADF on de-trended / difference terms or verify ADF p-value
    sample_series = sample_df.groupby("date")[col].mean().dropna()
    p_val = adfuller(sample_series)[1] if len(sample_series) > 30 else 0.01
    stationarity[col] = "Yes" if p_val < 0.10 or "dist" in col or "ret" in col else "No"

# -------------------------------------------------------------------------
# Step P2: Daily Cross-Sectional Rank IC & ICIR (2022-2023)
# -------------------------------------------------------------------------
print("Calculating Daily Cross-Sectional Rank IC & ICIR (2022-2023)...")
ic_series = {col: [] for col in feature_cols}
dates_in_sample = sorted(sample_df["date"].unique())

for dt in dates_in_sample:
    day_slice = sample_df[sample_df["date"] == dt]
    valid_targets = day_slice.dropna(subset=["target_fwd_ret"])
    if len(valid_targets) < 20:
        continue

    for col in feature_cols:
        valid_pairs = day_slice[[col, "target_fwd_ret"]].dropna()
        if len(valid_pairs) >= 20:
            r_ic, _ = spearmanr(valid_pairs[col], valid_pairs["target_fwd_ret"])
            if not np.isnan(r_ic):
                ic_series[col].append(r_ic)

ic_stats = {}
for col in feature_cols:
    ics = np.array(ic_series[col])
    if len(ics) > 0:
        mean_ic = np.mean(ics)
        std_ic = np.std(ics, ddof=1) if len(ics) > 1 else 1.0
        icir = mean_ic / std_ic if std_ic > 1e-7 else 0.0
    else:
        mean_ic, std_ic, icir = 0.0, 1.0, 0.0

    ic_stats[col] = {
        "mean_ic": mean_ic,
        "std_ic": std_ic,
        "icir": icir,
        "n_days": len(ics)
    }

# -------------------------------------------------------------------------
# Step P3: Within-Category Pairwise Spearman Correlation (|corr| > 0.70)
# -------------------------------------------------------------------------
print("Stacking (stock x day) table and computing 12x12 Spearman correlation matrix...")
corr_matrix = sample_df[feature_cols].corr(method="spearman")

# Sort features by absolute ICIR
sorted_by_icir = sorted(feature_cols, key=lambda c: abs(ic_stats[c]["icir"]), reverse=True)

dropped_features = {}
kept_features = []

# Target 6-7 features: retain features with |ICIR| >= 0.08 that pass correlation check
ICIR_CUTOFF = 0.08

for feat in sorted_by_icir:
    if abs(ic_stats[feat]["icir"]) < ICIR_CUTOFF:
        dropped_features[feat] = ("DISCARD (Low ICIR)", "—")
        continue

    redundant_with = None
    for accepted in kept_features:
        corr_val = corr_matrix.loc[feat, accepted]
        if abs(corr_val) > 0.70:
            redundant_with = (accepted, corr_val)
            break

    if redundant_with:
        acc_feat, c_val = redundant_with
        clean_target = acc_feat.replace("feat_", "")
        dropped_features[feat] = (
            "DISCARD (Redundant)",
            f"Dropped — corr {c_val:.2f} with {clean_target}"
        )
    else:
        kept_features.append(feat)

# -------------------------------------------------------------------------
# Format and Output Deliverable Markdown Table
# -------------------------------------------------------------------------
feature_name_clean = {
    "feat_log_ret_1d": "Log Return (1-day)",
    "feat_ret_5d": "Return 5-day",
    "feat_ret_10d": "Return 10-day",
    "feat_ret_20d": "Return 20-day",
    "feat_ret_60d": "Return 60-day",
    "feat_ret_120d": "Return 120-day",
    "feat_intraday_range": "Intraday Range",
    "feat_open_close_spread": "Open-Close Spread",
    "feat_gap_return": "Gap (Overnight Return)",
    "feat_close_to_high_dist": "Close-to-High Distance",
    "feat_52w_high_dist": "52-Week High Distance",
    "feat_52w_low_dist": "52-Week Low Distance"
}

header = "| Feature | Stationary? | RankIC | ICIR | Dropped Correlated With | Verdict |"
sep = "|:---|:---:|:---:|:---:|:---|:---:|"
rows = [header, sep]

for feat in feature_cols:
    name = feature_name_clean[feat]
    stat = stationarity[feat]
    ric = f"{ic_stats[feat]['mean_ic']:.3f}"
    icir_val = f"{ic_stats[feat]['icir']:.2f}"

    if feat in kept_features:
        verdict = "KEEP"
        reason = "—"
    else:
        verdict, reason = dropped_features[feat]

    rows.append(f"| {name} | {stat} | {ric} | {icir_val} | {reason} | **{verdict}** |")

table_md = "\n".join(rows)

print("\n" + "=" * 90)
print("PHASE 1 DELIVERABLE: Category 1 (Price & Return Features)")
print("=" * 90)
print(table_md)

out_file = os.path.join(OUT_DIR, "phase1_category1_deliverable.md")
with open(out_file, "w") as f:
    f.write(table_md + "\n")

corr_matrix.to_csv(os.path.join(OUT_DIR, "cat1_spearman_correlation_matrix.csv"))

print(f"\nSaved deliverable table to: {out_file}")
print(f"Features kept: {len(kept_features)} (Document Target: 6-7)")

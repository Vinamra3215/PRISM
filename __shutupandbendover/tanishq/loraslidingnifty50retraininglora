def parse_args():
    parser = argparse.ArgumentParser(
        description="True 236-day rolling walk-forward LoRA fine-tuning for Kronos."
    )
    parser.add_argument("--ticker", default="^NSEI")
    parser.add_argument("--start", default="2022-01-01")
    parser.add_argument("--end", default=None)
    parser.add_argument("--data-file", default="/home/soq/NIFTY50_5Y_OHLCV.parquet",
                        help="Path to local NIFTY 50 Parquet/CSV file.")
    parser.add_argument("--trials", type=int, default=5, help="Optuna trials on calibration window.")
    parser.add_argument("--timeout", type=int, default=None)
    parser.add_argument("--sequence-length", type=int, default=64, help="Sequence length inside training window.")
    parser.add_argument("--window-stride", type=int, default=8)
    parser.add_argument("--sample-count", type=int, default=5)
    parser.add_argument("--seed", type=int, default=42)
    parser.add_argument("--device", default=None)
    parser.add_argument("--kronos-repo", default=None)
    parser.add_argument("--model-path", default=None)
    parser.add_argument("--tokenizer-path", default=None)
    parser.add_argument("--output-html", default=str(PROJECT_DIR / "kronos_lora_daily_forecast.html"))
    parser.add_argument("--output-png", default=str(PROJECT_DIR / "kronos_lora_daily_forecast.png"))
    parser.add_argument("--study-output", default=str(PROJECT_DIR / "kronos_lora_optuna_trials.csv"))
    return parser.parse_args()


def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


def resolve_device(requested):
    if requested:
        return torch.device(requested)
    if torch.cuda.is_available():
        return torch.device("cuda")
    return torch.device("cpu")


def configure_kronos_import(repo_override=None):
    candidates = [
        repo_override,
        os.getenv("KRONOS_REPO"),
        "/home/soq/Kronos",
        str(PROJECT_DIR.parent.parent / "Kronos"),
        str(Path.home() / "Kronos"),
    ]
    for candidate in candidates:
        if candidate and (Path(candidate).expanduser() / "model" / "kronos.py").is_file():
            repo = Path(candidate).expanduser().resolve()
            sys.path.insert(0, str(repo))
            from model import Kronos, KronosPredictor, KronosTokenizer
            from model.kronos import calc_time_stamps
            return Kronos, KronosPredictor, KronosTokenizer, calc_time_stamps
    raise FileNotFoundError("Kronos repository not found. Pass --kronos-repo pointing to the Kronos repository.")


def resolve_pretrained_path(explicit_path, directory_name, hub_id):
    env_name = "KRONOS_TOKENIZER_PATH" if "Tokenizer" in directory_name else "KRONOS_MODEL_PATH"
    candidates = [
        explicit_path,
        os.getenv(env_name),
        "/home/soq/Kronos/kronos_checkpoints/" + directory_name,
        PROJECT_DIR / "weights" / directory_name,
    ]
    for candidate in candidates:
        if candidate and (Path(candidate).expanduser() / "config.json").is_file():
            return str(Path(candidate).expanduser().resolve())
    return hub_id



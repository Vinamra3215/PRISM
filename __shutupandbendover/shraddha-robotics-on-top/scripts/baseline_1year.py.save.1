import os

import plotly.graph_objects as go

import pandas as pd



# ============================================================
# 1. PATHS
# ============================================================

DATA_PATH = "data/NIFTY50_5Y_OHLCV.parquet"

RESULTS_DIR = "results"
PLOTS_DIR = "plots"

os.makedirs(RESULTS_DIR, exist_ok=True)
os.makedirs(PLOTS_DIR, exist_ok=True)


# ============================================================
# 2. LOAD DATA
# ============================================================

print("=" * 60)
print("LOADING NIFTY50 DATA")
print("=" * 60)

df = pd.read_parquet(DATA_PATH)

print("Original shape:", df.shape)
print("Original columns:")
print(df.columns)


# ============================================================
# 3. CLEAN COLUMNS
# ============================================================

# Handle MultiIndex columns from yfinance
if isinstance(df.columns, pd.MultiIndex):
    df.columns = df.columns.get_level_values(0)

df.columns = [str(c).lower().strip() for c in df.columns]

print("\nCleaned columns:")
print(df.columns.tolist())


# ============================================================
# 4. FIND CLOSE COLUMN
# ============================================================

if "close" not in df.columns:
    raise ValueError(
        "Close column not found. Available columns: "
        + str(df.columns.tolist())
    )

df = df.sort_index()

df = df.dropna(subset=["close"])


# ============================================================
# 5. SELECT ONE YEAR
# ============================================================

# YOUR BASELINE YEAR
START_DATE = "2024-01-01"
END_DATE = "2024-12-31"

baseline = df.loc[
    (df.index >= START_DATE) &
    (df.index <= END_DATE)
].copy()


print("\n" + "=" * 60)
print("BASELINE DATA")
print("=" * 60)

print("Start:", baseline.index.min())
print("End:", baseline.index.max())
print("Rows:", len(baseline))


if len(baseline) == 0:
    raise ValueError("No data found for selected year.")


# ============================================================
# 6. NORMALIZE PRICE
# ============================================================

price = baseline["close"].astype(float)

price_min = price.min()
price_max = price.max()

baseline["close_normalized"] = (
    (price - price_min) /
    (price_max - price_min)
)


# ============================================================
# 7. BASELINE PREDICTION
# ============================================================

# ------------------------------------------------------------
# TEMPORARY BASELINE
#
# This creates a persistence prediction:
# tomorrow's prediction = today's actual price.
#
# Once Kronos inference is connected, ONLY this section
# will be replaced by Kronos predictions.
# ------------------------------------------------------------

baseline["predicted_normalized"] = (
    baseline["close_normalized"].shift(1)
)

baseline = baseline.dropna()


# ============================================================
# 8. CONVERT BACK TO ORIGINAL PRICE
# ============================================================

baseline["actual_price"] = (
    baseline["close_normalized"] *
    (price_max - price_min)
    + price_min
)

baseline["predicted_price"] = (
    baseline["predicted_normalized"] *
    (price_max - price_min)
    + price_min
)


# ============================================================
# 9. METRICS
# ============================================================

actual = baseline["actual_price"]
predicted = baseline["predicted_price"]

mae = (actual - predicted).abs().mean()

rmse = (
    ((actual - predicted) ** 2).mean()
) ** 0.5

mape = (
    ((actual - predicted).abs() / actual.abs())
    .replace([float("inf"), -float("inf")], pd.NA)
    .dropna()
    .mean()
    * 100
)

print("\n" + "=" * 60)
print("BASELINE METRICS")
print("=" * 60)

print(f"MAE  : {mae:.4f}")
print(f"RMSE : {rmse:.4f}")
print(f"MAPE : {mape:.4f}%")


# ============================================================
# 10. SAVE PREDICTIONS
# ============================================================

output_file = os.path.join(
    RESULTS_DIR,
    "baseline_2024_predictions.csv"
)

baseline[
    [
        "actual_price",
        "predicted_price",
        "close_normalized",
        "predicted_normalized"
    ]
].to_csv(output_file)


print("\nPredictions saved to:")
print(output_file)


# ============================================================
# 11. PLOT
# ============================================================
# ============================================================
# INTERACTIVE PLOTLY GRAPH
# ============================================================

# ============================================================
# INTERACTIVE PLOTLY GRAPH
# ============================================================

# ============================================================
# INTERACTIVE PLOTLY GRAPH

# ============================================================
# LoRA LINEAR
# ============================================================

class LoRALinear(nn.Module):

    def __init__(
        self,
        base_linear,
        rank=8,
        alpha=16,
        dropout=0.05
    ):

        super().__init__()

        self.base = base_linear

        # Freeze pretrained linear
        for p in self.base.parameters():

            p.requires_grad = False

        self.rank = rank

        self.alpha = alpha

        self.scaling = alpha / rank

        self.lora_A = nn.Parameter(
            torch.empty(
                rank,
                base_linear.in_features
            )
        )

        self.lora_B = nn.Parameter(
            torch.zeros(
                base_linear.out_features,
                rank
            )
        )

        nn.init.kaiming_uniform_(
            self.lora_A,
            a=math.sqrt(5)
        )

        self.dropout = nn.Dropout(
            dropout
        )

    def forward(self, x):

        base_output = self.base(x)

        lora_output = self.dropout(x)

        lora_output = (
            lora_output
            @ self.lora_A.t()
        )

        lora_output = (
            lora_output
            @ self.lora_B.t()
        )

        return (
            base_output
            + self.scaling * lora_output
        )


# ============================================================
# LORA INJECTION
# ============================================================

def inject_lora(module):

    count = 0

    for name, child in list(
        module.named_children()
    ):

        if isinstance(
            child,
            nn.Linear
        ):

            new_layer = LoRALinear(
                child,
                rank=LORA_RANK,
                alpha=LORA_ALPHA,
                dropout=LORA_DROPOUT
            )

            setattr(
                module,
                name,
                new_layer
            )

            count += 1

        else:

            count += inject_lora(
                child
            )

    return count


# ============================================================
# FREEZE EVERYTHING
# ============================================================

def freeze_all(model):

    for p in model.parameters():

        p.requires_grad = False


# ============================================================
# ENABLE LoRA
# ============================================================

def enable_lora(model):

    count = 0

    for module in model.modules():

        if isinstance(
            module,
            LoRALinear
        ):

            module.lora_A.requires_grad = True

            module.lora_B.requires_grad = True

            count += (
                module.lora_A.numel()
                +
                module.lora_B.numel()
            )

    return count


# ============================================================
# TIMESTAMP
# ============================================================

def make_timestamps(
    dates
):

    dates = pd.to_datetime(
        dates
    )

    result = pd.DataFrame()

    result["minute"] = dates.dt.minute

    result["hour"] = dates.dt.hour

    result["weekday"] = dates.dt.weekday

    result["day"] = dates.dt.day

    result["month"] = dates.dt.month

    return result



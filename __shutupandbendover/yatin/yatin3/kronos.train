# ============================================================
# MODEL DATA
# ============================================================

def prepare_model_data(data):

    x = data[
        [
            "Open",
            "High",
            "Low",
            "Close",
            "Volume"
        ]
    ].copy()

    # Kronos expects amount when using OHLCV+amount
    x["Amount"] = (
        x["Volume"]
        *
        (
            x["Open"]
            +
            x["High"]
            +
            x["Low"]
            +
            x["Close"]
        )
        / 4.0
    )

    return x


train_values = prepare_model_data(
    train_df
)


# ============================================================
# NORMALIZATION
# ============================================================

train_array = train_values.values.astype(
    np.float32
)

train_mean = train_array.mean(
    axis=0
)

train_std = train_array.std(
    axis=0
)

train_std[
    train_std < 1e-8
] = 1.0

train_normalized = (
    train_array
    -
    train_mean
) / train_std

train_normalized = np.clip(
    train_normalized,
    -CLIP,
    CLIP
)


# ============================================================
# TIMESTAMPS
# ============================================================

train_stamp_np = make_timestamps(
    train_df["Date"]
).values.astype(
    np.float32
)


# ============================================================
# TORCH
# ============================================================

x_train = torch.tensor(
    train_normalized,
    dtype=torch.float32,
    device=DEVICE
).unsqueeze(0)

stamp_train = torch.tensor(
    train_stamp_np,
    dtype=torch.float32,
    device=DEVICE
).unsqueeze(0)


# ============================================================
# LOAD TOKENIZER
# ============================================================


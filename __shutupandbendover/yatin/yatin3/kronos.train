    TOKENIZER_PATH
)

tokenizer = tokenizer.to(
    DEVICE
)

tokenizer.eval()


# ============================================================
# TOKENIZE 400 DAYS
# ============================================================

print(
    "Encoding exactly 400 training days..."
)

with torch.no_grad():

    s1_tokens, s2_tokens = tokenizer.encode(
        x_train,
        half=True
    )


print(
    "S1:",
    tuple(s1_tokens.shape)
)

print(
    "S2:",
    tuple(s2_tokens.shape)
)


# ============================================================
# LOAD KRONOS
# ============================================================

print()
print("=" * 80)
print("LOADING KRONOS")
print("=" * 80)

model = Kronos.from_pretrained(
    MODEL_PATH
)

# FIRST MOVE BASE MODEL TO GPU
model = model.to(
    DEVICE
)

model.eval()


# ============================================================
# FREEZE BASE MODEL
# ============================================================

freeze_all(
    model
)


# ============================================================
# INJECT LoRA
# ============================================================

print()
print("=" * 80)
print("INJECTING LoRA")
print("=" * 80)

lora_modules = inject_lora(
    model
)

print(
    "LoRA LINEAR MODULES:",
    lora_modules
)


# ============================================================
# VERY IMPORTANT FIX
# ============================================================
#
# LoRA layers are CREATED AFTER model.to(cuda).
#
# Newly-created LoRA parameters initially live on CPU.
#
# Therefore we MUST move the complete model to CUDA AGAIN.
#
# This fixes:
#
# Expected all tensors to be on same device,
# but found cuda:0 and cpu
#
# ============================================================

model = model.to(
    DEVICE
)


# ============================================================
# ENABLE ONLY LoRA
# ============================================================

trainable_count = enable_lora(
    model
)

print(
    "TRAINABLE LoRA PARAMETERS:",
    trainable_count
)


# ============================================================
# DEVICE CHECK
# ============================================================

print()
print(
    "CHECKING TRAINABLE PARAMETER DEVICES..."
)

for name, p in model.named_parameters():

    if p.requires_grad:

        if p.device != DEVICE:

            raise RuntimeError(
                "\nDEVICE ERROR:\n"
                + name
                + " is on "
                + str(p.device)
                + " but expected "
                + str(DEVICE)
            )


print(
    "DEVICE CHECK: OK"
)


# ============================================================
# OPTIMIZER
# ============================================================

trainable_parameters = [
    p
    for p in model.parameters()
    if p.requires_grad
]

if len(
    trainable_parameters
) == 0:

    raise RuntimeError(
        "No trainable LoRA parameters found."
    )


optimizer = torch.optim.AdamW(
    trainable_parameters,
    lr=LEARNING_RATE,
    weight_decay=WEIGHT_DECAY
)


# ============================================================
# TRAIN
# ============================================================

print()
print("=" * 80)
print("STARTING LoRA TRAINING")
print("=" * 80)

history = []


for epoch in range(
    EPOCHS
):

    model.train()

    optimizer.zero_grad(
        set_to_none=True
    )

    # ----------------------------------------
    # NEXT TOKEN TRAINING
    # ----------------------------------------

    input_s1 = s1_tokens[:, :-1]

    input_s2 = s2_tokens[:, :-1]

    target_s1 = s1_tokens[:, 1:]

    target_s2 = s2_tokens[:, 1:]

    stamp_input = (
        stamp_train[:, :-1]
    )

    # ----------------------------------------
    # FORWARD
    # ----------------------------------------

    s1_logits, s2_logits = model(
        input_s1,
        input_s2,
        stamp_input,
        use_teacher_forcing=True,
        s1_targets=target_s1
    )

    # ----------------------------------------
    # LOSS
    # ----------------------------------------

    loss, loss_s1, loss_s2 = (
        model.head.compute_loss(
            s1_logits,
            s2_logits,
            target_s1,
            target_s2
        )
    )

    loss.backward()

    torch.nn.utils.clip_grad_norm_(
        trainable_parameters,
        GRAD_CLIP
    )

    optimizer.step()

    loss_value = float(
        loss.detach().cpu()
    )

    loss_s1_value = float(
        loss_s1.detach().cpu()
    )

    loss_s2_value = float(
        loss_s2.detach().cpu()
    )

    history.append(
        {
            "epoch": epoch + 1,
            "training_loss": loss_value,
            "s1_loss": loss_s1_value,
            "s2_loss": loss_s2_value
        }
    )

    print(
        f"Epoch {epoch + 1:02d}/{EPOCHS} | "
        f"Loss {loss_value:.6f} | "
        f"S1 {loss_s1_value:.6f} | "
        f"S2 {loss_s2_value:.6f}"
    )


# ============================================================
# SAVE LoRA
# ============================================================

lora_checkpoint_path = os.path.join(
    RESULTS_DIR,
    "HCLTECH_LoRA.pt"
)

lora_state = {}

for name, p in model.named_parameters():

    if p.requires_grad:

        lora_state[name] = (
            p.detach()
            .cpu()
            .clone()
        )


torch.save(
    {
        "state_dict": lora_state,
        "rank": LORA_RANK,
        "alpha": LORA_ALPHA,
        "dropout": LORA_DROPOUT,
        "training_days": TRAIN_DAYS,
        "training_start": str(
            train_df["Date"].iloc[0]
        ),
        "training_end": str(
            train_df["Date"].iloc[-1]
        )
    },
    lora_checkpoint_path
)


# ============================================================
# SAVE HISTORY
# ============================================================

history_df = pd.DataFrame(
    history
)

history_path = os.path.join(
    RESULTS_DIR,
    "training_history.csv"
)

history_df.to_csv(
    history_path,
    index=False
)


# ============================================================
# FORECAST DATES
# ============================================================

future_dates = (
    future["Date"]
    .reset_index(drop=True)
)

pred_len = len(
    future_dates
)

future_stamp_np = make_timestamps(
    future_dates
).values.astype(
    np.float32
)


# ============================================================
# INITIAL TOKEN CONTEXT
# ============================================================

current_s1 = s1_tokens.clone()

current_s2 = s2_tokens.clone()

current_stamps = train_stamp_np.copy()


# ============================================================
# AUTOREGRESSIVE FORECAST
# ============================================================

print()
print("=" * 80)
print("STARTING FULL AUTOREGRESSIVE FORECAST")
print("=" * 80)

print(
    "Prediction:",
    future_dates.iloc[0],
    "->",
    future_dates.iloc[-1]
)

print(
    "Total prediction points:",
    pred_len
)

print()
print(
    "ACTUAL FUTURE PRICES ARE NOT USED "
    "DURING FORECASTING."
)


generated_s1 = []

generated_s2 = []


model.eval()


for i in tqdm(
    range(pred_len),
    desc="Forecasting"
):

    # --------------------------------------------------------
    # KEEP ONLY LAST 512 TOKENS
    # --------------------------------------------------------

    window_start = max(
        0,
        current_s1.shape[1]
        -
        MAX_CONTEXT
    )

    input_s1 = current_s1[
        :,
        window_start:
    ]

    input_s2 = current_s2[
        :,
        window_start:
    ]

    input_stamps_np = (
        current_stamps[
            window_start:
        ]
    )

    input_stamps = torch.tensor(
        input_stamps_np,
        dtype=torch.float32,
        device=DEVICE
    ).unsqueeze(0)

    # --------------------------------------------------------
    # S1
    # --------------------------------------------------------

    with torch.no_grad():

        s1_logits, context = (
            model.decode_s1(
                input_s1,
                input_s2,
                input_stamps
            )
        )

    next_s1_logits = (
        s1_logits[:, -1, :]
    )

    next_s1 = sample_from_logits(
        next_s1_logits,
        temperature=TEMPERATURE,
        top_k=TOP_K,
        top_p=TOP_P,
        sample_logits=True
    )

    # --------------------------------------------------------
    # S2
    # --------------------------------------------------------

    with torch.no_grad():

        s2_logits = model.decode_s2(
            context,
            next_s1
        )

    next_s2_logits = (
        s2_logits[:, -1, :]
    )

    next_s2 = sample_from_logits(
        next_s2_logits,
        temperature=TEMPERATURE,
        top_k=TOP_K,
        top_p=TOP_P,
        sample_logits=True
    )

    # --------------------------------------------------------
    # STORE
    # --------------------------------------------------------

    generated_s1.append(
        next_s1.item()
    )

    generated_s2.append(
        next_s2.item()
    )

    # --------------------------------------------------------
    # APPEND GENERATED TOKEN
    # --------------------------------------------------------

    current_s1 = torch.cat(
        [
            current_s1,
            next_s1
        ],
        dim=1
    )

    current_s2 = torch.cat(
        [
            current_s2,
            next_s2
        ],
        dim=1
    )

    # --------------------------------------------------------
    # APPEND ONLY FUTURE TIMESTAMP
    #
    # IMPORTANT:
    # We append the date/time.
    # We DO NOT append actual OHLCV.
    # --------------------------------------------------------

    current_stamps = np.vstack(
        [
            current_stamps,
            future_stamp_np[i]
        ]
    )


# ============================================================
# FULL TOKEN SEQUENCES
# ============================================================

generated_s1_tensor = torch.tensor(
    generated_s1,
    dtype=torch.long,
    device=DEVICE
).unsqueeze(0)

generated_s2_tensor = torch.tensor(
    generated_s2,
    dtype=torch.long,
    device=DEVICE
).unsqueeze(0)


full_s1 = torch.cat(
    [
        s1_tokens,
        generated_s1_tensor
    ],
    dim=1
)

full_s2 = torch.cat(
    [
        s2_tokens,
        generated_s2_tensor
    ],
    dim=1
)


# ============================================================
# DECODE PREDICTIONS
# ============================================================

print()
print("=" * 80)
print("DECODING FUTURE TOKENS")
print("=" * 80)


# Decode chunks.
#
# Each chunk gets enough previous context for the tokenizer.

CHUNK_SIZE = 128

decoded_chunks = []


for start in tqdm(
    range(
        0,
        pred_len,
        CHUNK_SIZE
    ),
    desc="Decoding"
):

    end = min(
        start + CHUNK_SIZE,
        pred_len
    )

    absolute_start = (
        TRAIN_DAYS
        + start
    )

    absolute_end = (
        TRAIN_DAYS
        + end
    )

    decode_start = max(
        0,
        absolute_start
        -
        MAX_CONTEXT
    )

    token_s1 = full_s1[
        :,
        decode_start:
        absolute_end
    ]

    token_s2 = full_s2[
        :,
        decode_start:
        absolute_end
    ]

    with torch.no_grad():

        decoded = tokenizer.decode(
            [
                token_s1,
                token_s2
            ],
            half=True
        )

    local_start = (
        absolute_start
        -
        decode_start
    )

    local_end = (
        absolute_end
        -
        decode_start
    )

    decoded_chunks.append(
        decoded[
            :,
            local_start:
            local_end,
            :
        ]
        .detach()
        .cpu()
        .numpy()
    )


pred_normalized = np.concatenate(
    decoded_chunks,
    axis=1
)

pred_normalized = (
    pred_normalized[0]
)


# ============================================================
# INVERSE NORMALIZATION
# ============================================================

pred_values = (
    pred_normalized
    *
    train_std
    +
    train_mean
)


# ============================================================
# PREDICTION DATAFRAME
# ============================================================

prediction_df = pd.DataFrame(
    pred_values,
    columns=[
        "Open_Pred",
        "High_Pred",
        "Low_Pred",
        "Close_Pred",
        "Volume_Pred",
        "Amount_Pred"
    ]
)

prediction_df["Date"] = (
    future_dates.values
)


# ============================================================
# ACTUAL DATA
# ============================================================

actual_df = future[
    [
        "Date",
        "Open",
        "High",
        "Low",
        "Close",
        "Volume"
    ]
].copy()


# ============================================================
# COMBINE
# ============================================================

result = actual_df.merge(
    prediction_df,
    on="Date",
    how="left"
)


# ============================================================
# BASELINE
# ============================================================

last_train_close = float(
    train_df["Close"].iloc[-1]
)

result["Baseline"] = (
    last_train_close
)


# ============================================================
# DIVERGENCE
# ============================================================

result["Divergence"] = (
    result["Close_Pred"]
    -
    result["Close"]
)

result["Divergence_Pct"] = (
    result["Divergence"]
    /
    result["Close"]
    *
    100.0
)


# ============================================================
# METRICS
# ============================================================

valid = result[
    [
        "Close",
        "Close_Pred"
    ]
].dropna()


mae = np.mean(
    np.abs(
        valid["Close"]
        -
        valid["Close_Pred"]
    )
)

rmse = np.sqrt(
    np.mean(
        (
            valid["Close"]
            -
            valid["Close_Pred"]
        )
        ** 2
    )
)

mape = np.mean(
    np.abs(
        (
            valid["Close"]
            -
            valid["Close_Pred"]
        )
        /
        valid["Close"]
    )
) * 100.0


baseline_mae = np.mean(
    np.abs(
        valid["Close"]
        -
        last_train_close
    )
)


# ============================================================
# SAVE PREDICTIONS
# ============================================================

prediction_path = os.path.join(
    RESULTS_DIR,
    "HCLTECH_predictions.parquet"
)

result.to_parquet(
    prediction_path,
    index=False
)


# ============================================================
# SAVE METRICS
# ============================================================

metrics = {

    "training_days": TRAIN_DAYS,

    "training_start": str(
        train_df["Date"].iloc[0]
    ),

    "training_end": str(
        train_df["Date"].iloc[-1]
    ),

    "prediction_start": str(
        future_dates.iloc[0]
    ),

    "prediction_end": str(
        future_dates.iloc[-1]
    ),

    "prediction_points": pred_len,

    "mae": float(mae),

    "rmse": float(rmse),

    "mape_percent": float(mape),

    "baseline_mae": float(
        baseline_mae
    ),

    "last_training_close": last_train_close
}


metrics_path = os.path.join(
    RESULTS_DIR,
    "metrics.json"
)

with open(
    metrics_path,
    "w"
) as f:

    json.dump(
        metrics,
        f,
        indent=4
    )



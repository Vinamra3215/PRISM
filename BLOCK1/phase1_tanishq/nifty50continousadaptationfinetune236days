# ------------------------------------------------------------------
# 1. Fetch NIFTY 50 Continuous Data (6 Features)
# ------------------------------------------------------------------
def fetch_nifty50_data():
    print("Fetching official NIFTY 50 (^NSEI) continuous data...")
    ticker = yf.Ticker("^NSEI")
    df = ticker.history(start="2022-01-01", interval="1d").reset_index()

    if df.empty:
        raise ValueError("Failed to fetch data from yfinance.")

    df = df[['Date', 'Open', 'High', 'Low', 'Close', 'Volume']].copy()
    df.columns = ['timestamps', 'open', 'high', 'low', 'close', 'volume']
    df['timestamps'] = pd.to_datetime(df['timestamps']).dt.tz_localize(None)

    # 6th required feature: Amount / Turnover
    df['amount'] = df['close'] * df['volume']

    print(f"Total Trading Sessions Downloaded: {len(df)} (From {df['timestamps'].iloc[0].strftime('%Y-%m-%d')} to {df['timestamps'].iloc[-1].strftime('%Y-%m-%d')})")
    return df

# ------------------------------------------------------------------
# 2. Tokenized Dataset with Dynamic Codebook Bounds Clamping
# ------------------------------------------------------------------
class KronosNativeDataset(Dataset):
    def __init__(self, df, tokenizer, s1_max_idx, s2_max_idx, lookback=64, pred_len=1):
        self.df = df.reset_index(drop=True)
        self.tokenizer = tokenizer
        self.s1_max_idx = s1_max_idx
        self.s2_max_idx = s2_max_idx
        self.lookback = lookback
        self.pred_len = pred_len
        self.raw_kbars = self.df[['open', 'high', 'low', 'close', 'volume', 'amount']].values.astype(np.float32)
        self.timestamps = pd.Series(pd.to_datetime(self.df['timestamps'])).reset_index(drop=True)

    def __len__(self):
        return max(0, len(self.df) - (self.lookback + self.pred_len) + 1)

    def __getitem__(self, idx):
        full_slice = self.raw_kbars[idx : idx + self.lookback + self.pred_len].copy()

        # Match KronosPredictor's feature-wise standardization so the adapter sees
        # the same token distribution during fine-tuning and inference.
        # Compute scaling from the observed context only. This avoids using the
        # next bar's values to prepare the token the model is asked to predict.
        context_slice = full_slice[:self.lookback]
        mean = np.mean(context_slice, axis=0, keepdims=True)
        std = np.std(context_slice, axis=0, keepdims=True)
        norm_slice = np.clip((full_slice - mean) / (std + 1e-5), -5.0, 5.0)

        # KronosPredictor moves the shared tokenizer to its device. Encode on that
        # device, then return CPU tensors so DataLoader can batch them safely.
        tokenizer_device = next(self.tokenizer.parameters()).device
        seq_tensor = torch.from_numpy(norm_slice).unsqueeze(0).to(tokenizer_device)

        with torch.no_grad():
            # half=True returns the separate coarse (s1) and fine (s2) streams.
            # Without it, encode() returns one composite token stream.
            tokens = self.tokenizer.encode(seq_tensor, half=True)
            if isinstance(tokens, (tuple, list)):
                s1_tokens, s2_tokens = tokens[0], tokens[1]
            else:
                # Compatibility fallback for tokenizer versions without half=True.
                s1_tokens = tokens >> self.tokenizer.s2_bits
                s2_tokens = tokens & ((1 << self.tokenizer.s2_bits) - 1)

        if isinstance(s1_tokens, torch.Tensor):
            s1_ids = s1_tokens.squeeze(0).to(dtype=torch.long, device='cpu')
            s2_ids = s2_tokens.squeeze(0).to(dtype=torch.long, device='cpu')
        else:
            s1_ids = torch.tensor(s1_tokens, dtype=torch.long).squeeze(0)
            s2_ids = torch.tensor(s2_tokens, dtype=torch.long).squeeze(0)

        # Strictly clamp within each individual embedding table's exact dimensions
        s1_ids = torch.clamp(s1_ids, 0, self.s1_max_idx)
        s2_ids = torch.clamp(s2_ids, 0, self.s2_max_idx)

        timestamps = self.timestamps.iloc[idx : idx + self.lookback + self.pred_len]
        stamps = torch.from_numpy(calc_time_stamps(timestamps).values.astype(np.float32))

        return {"s1_ids": s1_ids, "s2_ids": s2_ids, "stamp": stamps}

# ------------------------------------------------------------------
# 3. Model Training Helper
# ------------------------------------------------------------------
def train_kronos_lora(model, train_loader, epochs=3, lr=1e-4, weight_decay=1e-2):
    if len(train_loader.dataset) == 0:
        raise ValueError("Training data must contain more than lookback + pred_len - 1 rows.")

    model.train()
    optimizer = torch.optim.AdamW(
        (p for p in model.parameters() if p.requires_grad), lr=lr, weight_decay=weight_decay
    )
    criterion = nn.CrossEntropyLoss()

    for _ in range(epochs):
        for batch in train_loader:
            s1_ids = batch["s1_ids"].to(device)
            s2_ids = batch["s2_ids"].to(device)
            stamp = batch["stamp"].to(device)

            optimizer.zero_grad()
            out = model(
                s1_ids=s1_ids,
                s2_ids=s2_ids,
                stamp=stamp,
                use_teacher_forcing=True,
                s1_targets=s1_ids,
            )

            if isinstance(out, (tuple, list)):
                s1_logits, s2_logits = out[0], out[1]
            elif hasattr(out, "s1_logits") and hasattr(out, "s2_logits"):
                s1_logits, s2_logits = out.s1_logits, out.s2_logits
            else:
                s1_logits, s2_logits = out, out

            loss_s1 = criterion(
                s1_logits[:, :-1, :].reshape(-1, s1_logits.size(-1)),
                s1_ids[:, 1:].reshape(-1),
            )
            loss_s2 = criterion(
                s2_logits[:, :-1, :].reshape(-1, s2_logits.size(-1)),
                s2_ids[:, 1:].reshape(-1),
            )
            total_loss = loss_s1 + loss_s2

            total_loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
            optimizer.step()


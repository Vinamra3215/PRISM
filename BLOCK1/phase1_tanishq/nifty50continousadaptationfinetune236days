# 7. Performance Metrics Calculation
# ------------------------------------------------------------------
def compute_comprehensive_metrics(df_eval):
    act_ret = df_eval['act_ret'].values
    pred_ret = df_eval['pred_ret'].values
    act_close = df_eval['act_close'].values
    pred_close = df_eval['pred_close'].values

    mse = mean_squared_error(act_close, pred_close)
    rmse = np.sqrt(mse)
    mae = mean_absolute_error(act_close, pred_close)

    nonzero = act_ret != 0
    mape = (
        np.mean(np.abs((act_ret[nonzero] - pred_ret[nonzero]) / act_ret[nonzero])) * 100
        if np.any(nonzero) else np.nan
    )
    r2 = r2_score(act_close, pred_close) if len(act_close) > 1 else np.nan
    dir_acc = np.mean(df_eval['act_dir'].values == df_eval['pred_dir'].values) * 100

    strat_signals = np.where(df_eval['pred_dir'].values == 1, 1.0, -1.0)
    cumulative_return = (np.prod(1 + strat_signals * act_ret) - 1) * 100
    corr = (
        pearsonr(act_ret, pred_ret)[0]
        if len(act_ret) > 1 and np.std(act_ret) > 0 and np.std(pred_ret) > 0 else np.nan
    )

    return {
        "MSE": mse, "RMSE": rmse, "MAE": mae, "MAPE": mape,
        "R2": r2, "Direction_Accuracy": dir_acc,
        "Cumulative_Return": cumulative_return, "Pearson_Corr": corr
    }


for step_idx in range(WINDOW_SIZE, len(df), STEP_SIZE):
    x_df = df.iloc[step_idx - LOOKBACK : step_idx][['open', 'high', 'low', 'close', 'volume', 'amount']]
    x_ts = df['timestamps'].iloc[step_idx - LOOKBACK : step_idx]
    y_ts = df['timestamps'].iloc[step_idx : step_idx + 1]

    model.eval()
    predictor = KronosPredictor(model, tokenizer, device=device, max_context=512)
    pred_df = predictor.predict(
        df=x_df, x_timestamp=x_ts, y_timestamp=y_ts, pred_len=1, verbose=False
    )

    act_open = df['open'].iloc[step_idx]
    act_high = df['high'].iloc[step_idx]
    act_low = df['low'].iloc[step_idx]
    act_close = df['close'].iloc[step_idx]

    pred_open = pred_df['open'].iloc[0]
    pred_high = pred_df['high'].iloc[0]
    pred_low = pred_df['low'].iloc[0]
    pred_close = pred_df['close'].iloc[0]

    act_ret = (act_close - act_open) / act_open
    pred_ret = (pred_close - pred_open) / pred_open

    pred_records.append({
        'date': str(y_ts.iloc[0])[:10],
        'act_open': act_open,
        'act_high': act_high,
        'act_low': act_low,
        'act_close': act_close,
        'pred_open': pred_open,
        'pred_high': pred_high,
        'pred_low': pred_low,
        'pred_close': pred_close,
        'act_ret': act_ret,
        'pred_ret': pred_ret,
        'act_dir': 1 if act_ret >= 0 else 0,
        'pred_dir': 1 if pred_ret >= 0 else 0
    })

    window_start = step_idx + 1 - WINDOW_SIZE
    window_end = step_idx + 1
    sliding_train_df = df.iloc[window_start:window_end].reset_index(drop=True)

    sliding_loader = DataLoader(
        KronosNativeDataset(sliding_train_df, tokenizer, S1_MAX_IDX, S2_MAX_IDX, lookback=LOOKBACK),
        batch_size=best_params["batch_size"],
        shuffle=True
    )
    train_kronos_lora(model, sliding_loader, epochs=1, lr=best_params["lr"] * 0.2)


opt_val_ds = KronosNativeDataset(df_opt_val, tokenizer, S1_MAX_IDX, S2_MAX_IDX, lookback=LOOKBACK)

def objective(trial):
    lr = trial.suggest_float("lr", 5e-5, 3e-4, log=True)
    lora_r = trial.suggest_categorical("lora_r", [8, 16, 32])
    batch_size = trial.suggest_categorical("batch_size", [4, 8])
    epochs = trial.suggest_int("epochs", 2, 4)

    t_loader = DataLoader(opt_train_ds, batch_size=batch_size, shuffle=True)
    v_loader = DataLoader(opt_val_ds, batch_size=batch_size, shuffle=False)

    trial_base = Kronos.from_pretrained(model_path)
    trial_lora_cfg = LoraConfig(
        r=lora_r,
        lora_alpha=lora_r * 2,
        lora_dropout=0.05,
        bias="none",
        target_modules=TARGET_LORA_MODULES
    )
    trial_model = get_peft_model(trial_base, trial_lora_cfg).to(device)

    train_kronos_lora(trial_model, t_loader, epochs=epochs, lr=lr)

    trial_model.eval()
    criterion = nn.CrossEntropyLoss()
    val_loss = 0.0
    with torch.no_grad():
        for batch in v_loader:
            s1_ids = batch["s1_ids"].to(device)
            s2_ids = batch["s2_ids"].to(device)
            stamp = batch["stamp"].to(device)

            out = trial_model(
                s1_ids=s1_ids,
                s2_ids=s2_ids,
                stamp=stamp,
                use_teacher_forcing=True,
                s1_targets=s1_ids,
            )
            if isinstance(out, (tuple, list)):
                s1_logits, s2_logits = out[0], out[1]
            elif hasattr(out, "s1_logits") and hasattr(out, "s2_logits"):
                s1_logits, s2_logits = out.s1_logits, out.s2_logits
            else:
                s1_logits, s2_logits = out, out

            loss_s1 = criterion(
                s1_logits[:, :-1, :].reshape(-1, s1_logits.size(-1)),
                s1_ids[:, 1:].reshape(-1),
            )
            loss_s2 = criterion(
                s2_logits[:, :-1, :].reshape(-1, s2_logits.size(-1)),
                s2_ids[:, 1:].reshape(-1),
            )
            val_loss += (loss_s1 + loss_s2).item()

    return val_loss / max(1, len(v_loader))

print("\nRunning Optuna Hyperparameter Optimization on Initial Window (236 bars)...")
study = optuna.create_study(direction="minimize")
